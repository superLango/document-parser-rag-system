{
  "$defs": {
    "CoverageItem": {
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "status": {
          "default": "missing",
          "enum": [
            "found",
            "missing",
            "ambiguous",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "expected_locations": {
          "items": {
            "type": "string"
          },
          "title": "Expected Locations",
          "type": "array"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "field"
      ],
      "title": "CoverageItem",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "producer_version": {
      "default": "0.1.0",
      "title": "Producer Version",
      "type": "string"
    },
    "doc_id": {
      "title": "Doc Id",
      "type": "string"
    },
    "status": {
      "default": "review",
      "enum": [
        "pass",
        "review",
        "fail"
      ],
      "title": "Status",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/CoverageItem"
      },
      "title": "Items",
      "type": "array"
    },
    "gaps": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Gaps",
      "type": "array"
    },
    "stats": {
      "additionalProperties": true,
      "title": "Stats",
      "type": "object"
    }
  },
  "required": [
    "doc_id"
  ],
  "title": "CoverageAudit",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-schema-version": "0.1.0",
  "x-producer-version": "0.1.0"
}
