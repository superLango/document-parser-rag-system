{
  "$defs": {
    "ReferenceEdge": {
      "properties": {
        "raw": {
          "title": "Raw",
          "type": "string"
        },
        "standard_no": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Standard No"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "edition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Edition"
        },
        "dated": {
          "default": false,
          "title": "Dated",
          "type": "boolean"
        },
        "relation": {
          "default": "normative",
          "enum": [
            "normative",
            "informative",
            "table_note",
            "clause",
            "other"
          ],
          "title": "Relation",
          "type": "string"
        },
        "clause_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clause Id"
        },
        "page_no": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page No"
        },
        "resolved": {
          "default": false,
          "title": "Resolved",
          "type": "boolean"
        },
        "resolved_doc_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved Doc Id"
        },
        "resolution_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution Basis"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "current",
                "superseded",
                "conflict",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "superseded_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Superseded By"
        },
        "relevance": {
          "anyOf": [
            {
              "enum": [
                "schema",
                "method",
                "informative",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relevance"
        },
        "expand": {
          "default": false,
          "title": "Expand",
          "type": "boolean"
        },
        "selection_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selection Reason"
        }
      },
      "required": [
        "raw"
      ],
      "title": "ReferenceEdge",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "producer_version": {
      "default": "0.1.0",
      "title": "Producer Version",
      "type": "string"
    },
    "doc_id": {
      "title": "Doc Id",
      "type": "string"
    },
    "references": {
      "items": {
        "$ref": "#/$defs/ReferenceEdge"
      },
      "title": "References",
      "type": "array"
    },
    "gaps": {
      "items": {
        "type": "string"
      },
      "title": "Gaps",
      "type": "array"
    },
    "budget": {
      "additionalProperties": true,
      "title": "Budget",
      "type": "object"
    }
  },
  "required": [
    "doc_id"
  ],
  "title": "ReferenceGraph",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-schema-version": "0.1.0",
  "x-producer-version": "0.1.0"
}
