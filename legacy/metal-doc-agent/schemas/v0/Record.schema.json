{
  "$defs": {
    "ExtractedValue": {
      "properties": {
        "raw": {
          "title": "Raw",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "comparator": {
          "default": "eq",
          "enum": [
            "eq",
            "min",
            "max",
            "range",
            "text",
            "na"
          ],
          "title": "Comparator",
          "type": "string"
        },
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower"
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper"
        },
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "evidence_id": {
          "default": "",
          "title": "Evidence Id",
          "type": "string"
        }
      },
      "required": [
        "raw"
      ],
      "title": "ExtractedValue",
      "type": "object"
    }
  },
  "properties": {
    "record_id": {
      "title": "Record Id",
      "type": "string"
    },
    "source_table_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Table Id"
    },
    "grade": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Grade"
    },
    "grade_level": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Grade Level"
    },
    "condition": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Condition"
    },
    "facets": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Facets",
      "type": "object"
    },
    "properties": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ExtractedValue"
      },
      "title": "Properties"
    }
  },
  "required": [
    "record_id"
  ],
  "title": "Record",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-schema-version": "0.1.0",
  "x-producer-version": "0.1.0"
}
