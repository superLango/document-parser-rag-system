# Platform API image (FastAPI + SQLAlchemy + Alembic).
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

ARG PIP_INDEX_URL=https://pypi.org/simple
ARG PIP_TIMEOUT=600
ARG PIP_RETRIES=20

WORKDIR /app
COPY metal-doc-agent /app/metal-doc-agent
COPY apps/api /app/apps/api
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --index-url "$PIP_INDEX_URL" \
    --timeout "$PIP_TIMEOUT" --retries "$PIP_RETRIES" \
    -e "/app/metal-doc-agent[api,yaml]" -e /app/apps/api
# Keep packaging tooling out of the scanned blast radius (pip/setuptools advisories).
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --index-url "$PIP_INDEX_URL" \
    --timeout "$PIP_TIMEOUT" --retries "$PIP_RETRIES" --upgrade pip setuptools

WORKDIR /app/apps/api
EXPOSE 8000
CMD ["uvicorn", "hanson_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
