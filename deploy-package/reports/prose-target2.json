    "sample_records": {
      "外观": [
        {
          "raw": "钢管内外表面的直道深度应符合如下规定:",
          "clause": "7.6.2",
          "unit": "",
          "comparator": "text"
        },
        {
          "raw": "钢管的内外表面不应有裂纹、折叠、轧折、离层和结疤。 这些缺陷应完全清除,清除深度应不超过壁厚的10%,缺陷清除处的实际壁厚应不小于壁厚所允许的最小值。 缺陷清除处不准许焊补,且应圆滑过渡。",
          "clause": "7.6.1",
          "unit": "",
          "comparator": "text"
        },
        {
          "raw": "钢管的内外表面不应有裂纹、折叠、轧折、离层、结疤、毛刺、直道和锈蚀。 这些缺陷应完全清除,清除深度应不超过壁厚的10%,缺陷清除处的实际壁厚应不小于壁厚所允许的最小值。 缺陷清除处不准许焊补,且应圆滑过渡。",
          "clause": "B.4.1",
          "unit": "",
          "comparator": "text"
        }
      ],
      "尺寸": [
        {
          "raw": "尺寸精度的规定。 当需方要求高级尺寸精度时,应在合同中注明。",
          "clause": "7.9.1.4",
          "unit": "",
          "comparator": "text"
        },
        {
          "raw": "定尺长度允许偏差应符合如下规定:",
          "clause": "7.9.2.2.2",
          "unit": "",
          "comparator": "text"
        },
        {
          "raw": "倍尺长度每个切口应按如下规定留出余量:",
          "clause": "7.9.2.2.3",
          "unit": "",
          "comparator": "text"
        }
      ],
      "晶粒度": [
        {
          "raw": "需方有下述其他特殊要求时,由供需双方协商,并在合同中注明: a) 晶粒度; b) 非金属夹杂物; c) 高温拉伸; d) 其他要求。",
          "clause": "7.8.3",
          "unit": "",
          "comparator": "text"
        }
      ],
      "晶间腐蚀": [
        {
          "raw": "......................................................................................................... 除07Cr19Ni10、07Cr17Ni12Mo2、07Cr19Ni11Ti、07Cr18Ni11Nb牌号外,奥氏体不锈钢管应进行晶间腐蚀试验。",
          "clause": "7.5",
          "unit": "",
          "comparator": "text"
        }
      ],
      "涡流检测": [
        {
          "raw": "测或涡流检测。",
          "clause": "7.7.2",
          "unit": "",
          "comparator": "text"
        }
      ],
      "脱脂": [
        {
          "raw": "............................................................................................................... 钢管内外表面应进行脱脂处理。",
