          "unit": "",
          "comparator": "text"
        }
      ],
      "外观": [
        {
          "raw": "外观质量 GJB 5040 - 200 1 外观质量 GJB 5040 - 200 1",
          "clause": "3.9",
          "unit": "",
          "comparator": "text"
