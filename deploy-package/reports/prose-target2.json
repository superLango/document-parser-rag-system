    "sample_records": {
      "低倍": [
        {
          "raw": "锻件低倍流线标准由供需双方在试制期间商定,并在需方要求时提供照片。",
          "clause": "3.5.2",
          "unit": "",
          "comparator": "text"
        },
        {
          "raw": "锻件的横向酸浸低倍试片上不允许有肉眼可见的缩孔、气泡、空洞、翻皮、裂纹、白点、夹杂、点状偏析等。",
          "clause": "3.5-2",
          "unit": "",
          "comparator": "text"
        },
        {
          "raw": "轴类锻件的纵低倍应限制树枝状结晶残余,其允许级别由需方按照表5 选定。",
