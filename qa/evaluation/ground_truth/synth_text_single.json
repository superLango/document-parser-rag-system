  "tables": [],
  "texts": [
    {
      "text": "本标准适用于公司内部金属材料入厂检验，覆盖化学成分、力学性能与表面质量 三类检验项目。",
      "page": 1,
      "bbox": [
        90,
        146.0,
        520,
        198.0
      ]
    },
    {
      "text": "化学成分按 GB/T 223 系列方法执行；力学性能按 GB/T 22 8.1 执行；表面质量采用目视与涡流探伤相结合。",
      "page": 2,
      "bbox": [
        90,
        106.0,
        520,
        158.0
      ]
    },
    {
      "text": "任一检验项目不合格，判定该批次不合格，并按规定进行复验。",
      "page": 3,
      "bbox": [
        90,
        106.0,
        520,
        140.0
      ]
    }
  ],
