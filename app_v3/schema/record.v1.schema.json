{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hanson.local/app_v3/schema/record.v1.schema.json",
  "title": "Canonical Extraction Record v1",
  "description": "产品标准抽取的规范记录（app_v3 目标模式）。模型只输出结构/语义，代码负责归一与验证。",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "category", "item", "requirement", "unit", "conditions", "status"],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string", "const": "record.v1"},
    "category": {"type": "string", "minLength": 1},
    "item": {"type": "string", "minLength": 1},
    "item_aliases": {"type": "array", "items": {"type": "string"}},
    "grade": {"type": "string"},
    "grade_aliases": {"type": "array", "items": {"type": "string"}},
    "requirement": {"type": "string"},
    "operator": {"type": "string", "enum": ["", "≥", "≤", "<", ">", "=", "~"]},
    "unit": {"type": "string"},
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "试验温度": {"type": "string"},
        "试样状态": {"type": "string"},
        "尺寸厚度": {"type": "string"},
        "方向": {"type": "string"},
        "位置": {"type": "string"},
        "试验方法": {"type": "string"},
        "取样数量": {"type": "string"},
        "取样说明": {"type": "string"},
        "锻件类型": {"type": "string"},
        "其他": {"type": "string"}
      }
    },
    "enrichment": {"type": "object", "additionalProperties": true},
    "evidence": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "source": {"type": "string", "enum": ["table", "clause", "metadata", "semantic", "unknown"]},
        "page_no": {"type": "integer"},
        "table_id": {"type": "string"},
        "row": {"type": "integer"},
        "column": {"type": "integer"},
        "quote": {"type": "string"},
        "ref_id": {"type": "string"}
      }
    },
    "status": {"type": "string", "enum": ["ok", "warn", "unresolved"]},
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string"},
          "field": {"type": "string"},
          "message": {"type": "string"},
          "severity": {"type": "string", "enum": ["info", "warn", "error"]}
        },
        "additionalProperties": true
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "doc_id": {"type": "string"},
        "channel": {"type": "string"},
        "table_id": {"type": "string"},
        "raw": {"type": "string"}
      }
    }
  }
}
