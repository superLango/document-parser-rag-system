  "properties": {
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "doc_id": {
      "title": "Doc Id",
      "type": "string"
    },
    "standard_no": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Standard No"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "doc_type": {
      "default": "other",
      "enum": [
        "gb_t",
        "gjb",
        "enterprise",
        "agreement",
        "classification",
        "other"
      ],
      "title": "Doc Type",
      "type": "string"
    },
    "material": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Material"
    },
    "product_form": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Product Form"
    },
    "source_type": {
      "default": "unknown",
      "enum": [
        "digital_native",
        "scanned",
        "hybrid",
        "unknown"
      ],
      "title": "Source Type",
      "type": "string"
    },
    "annotation": {
      "$ref": "#/$defs/AnnotationMeta"
    },
    "tables": {
      "items": {
        "$ref": "#/$defs/GoldTable"
      },
      "title": "Tables",
      "type": "array"
    },
    "clauses": {
      "items": {
        "$ref": "#/$defs/GoldClause"
      },
      "title": "Clauses",
      "type": "array"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    }
  },
  "required": [
    "doc_id"
  ],
  "title": "GoldDocument",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-schema-version": "0.1.0",
  "x-producer-version": "0.1.0"
}
