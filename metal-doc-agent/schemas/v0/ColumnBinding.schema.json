    },
    "property": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Property"
    },
    "role": {
      "default": "unknown",
      "enum": [
        "row_key",
        "row_index",
        "condition",
        "measure",
        "method",
        "remark",
        "unknown"
      ],
      "title": "Role",
      "type": "string"
    },
    "unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
