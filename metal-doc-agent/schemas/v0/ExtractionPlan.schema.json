{
  "$defs": {
    "ExtractionField": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "canonical_name": {
          "title": "Canonical Name",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "source": {
          "default": "both",
          "enum": [
            "table",
            "clause",
            "both"
          ],
          "title": "Source",
          "type": "string"
        },
        "profiles": {
          "items": {
            "type": "string"
          },
          "title": "Profiles",
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "name",
        "canonical_name"
      ],
      "title": "ExtractionField",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "producer_version": {
      "default": "0.1.0",
      "title": "Producer Version",
      "type": "string"
    },
    "template": {
      "default": "product_full",
      "title": "Template",
      "type": "string"
    },
    "fields": {
      "items": {
        "$ref": "#/$defs/ExtractionField"
      },
      "title": "Fields",
      "type": "array"
    }
  },
  "title": "ExtractionPlan",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-schema-version": "0.1.0",
  "x-producer-version": "0.1.0"
}
