{
  "$defs": {
    "CoverageItem": {
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "status": {
          "default": "missing",
          "enum": [
            "found",
            "missing",
            "ambiguous",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "expected_locations": {
          "items": {
            "type": "string"
          },
          "title": "Expected Locations",
          "type": "array"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "field"
      ],
      "title": "CoverageItem",
      "type": "object"
    },
    "CoveragePlan": {
      "properties": {
        "schema_version": {
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "producer_version": {
          "default": "0.1.0",
          "title": "Producer Version",
          "type": "string"
        },
        "standard_no": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Standard No"
        },
        "template": {
          "default": "product_full",
          "title": "Template",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/CoverageItem"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "title": "CoveragePlan",
      "type": "object"
    },
    "ValidationIssue": {
      "properties": {
        "level": {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L3.5",
            "L4",
            "L5"
          ],
          "title": "Level",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "record_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Id"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "evidence_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Id"
        },
        "severity": {
          "default": "warn",
          "enum": [
            "info",
            "warn",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "level",
        "code",
        "message"
      ],
      "title": "ValidationIssue",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "producer_version": {
      "default": "0.1.0",
      "title": "Producer Version",
      "type": "string"
    },
    "doc_id": {
      "title": "Doc Id",
      "type": "string"
    },
    "status": {
      "default": "review",
      "enum": [
        "pass",
        "review",
        "fail"
      ],
      "title": "Status",
      "type": "string"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/ValidationIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "coverage": {
      "anyOf": [
        {
          "$ref": "#/$defs/CoveragePlan"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "stats": {
      "additionalProperties": true,
      "title": "Stats",
      "type": "object"
    }
  },
  "required": [
    "doc_id"
  ],
  "title": "AuditReport",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-schema-version": "0.1.0",
  "x-producer-version": "0.1.0"
}
