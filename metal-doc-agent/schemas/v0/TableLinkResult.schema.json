{
  "$defs": {
    "TableClauseLink": {
      "properties": {
        "table_id": {
          "title": "Table Id",
          "type": "string"
        },
        "clause_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clause Id"
        },
        "clause_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clause Title"
        },
        "page_no": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page No"
        },
        "basis": {
          "default": "none",
          "enum": [
            "explicit",
            "caption",
            "section",
            "nearest",
            "continuation",
            "none"
          ],
          "title": "Basis",
          "type": "string"
        },
        "confidence": {
          "default": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        }
      },
      "required": [
        "table_id"
      ],
      "title": "TableClauseLink",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "producer_version": {
      "default": "0.1.0",
      "title": "Producer Version",
      "type": "string"
    },
    "doc_id": {
      "title": "Doc Id",
      "type": "string"
    },
    "links": {
      "items": {
        "$ref": "#/$defs/TableClauseLink"
      },
      "title": "Links",
      "type": "array"
    },
    "orphans": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Orphans",
      "type": "array"
    },
    "coverage": {
      "additionalProperties": true,
      "title": "Coverage",
      "type": "object"
    }
  },
  "required": [
    "doc_id"
  ],
  "title": "TableLinkResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-schema-version": "0.1.0",
  "x-producer-version": "0.1.0"
}
