      }
    },
    {
      "clause_id": "3.3",
      "kind": "delivery",
      "quote": "棒材以锻态，且经车光或磨光后交货。",
      "fields": {
        "requirement": "棒材以锻态，且经车光或磨光后交货。表面粗糙度Ra应不大于3.2μm。"
      }
    },
    {
      "clause_id": "3.4.2.1",
