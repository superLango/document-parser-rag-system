# Application
APP_NAME=Hansight
APP_ENV=development
DEBUG=true

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=docparser
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://postgres:change_me@localhost:5432/docparser

# Redis
REDIS_URL=redis://localhost:6379/0

# S3兼容存储 (SeaweedFS，字段名保留兼容)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio
MINIO_BUCKET=documents
MINIO_SECURE=false

# S3 Compatible Storage (SeaweedFS)
S3_ENDPOINT_URL=http://localhost:9000

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_neo4j

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=doc_chunks

# Embedding (bge-m3 Dense+Sparse)
EMBEDDING_MODEL_PATH=/home/hanson/doc_parse_project/models/bge-m3
EMBEDDING_BATCH_SIZE=16

# vLLM 大语言模型权重目录路径
LLM_MODEL_PATH=/home/hanson/doc_parse_project/models/Qwen/Qwen3___5-9B

# JWT
SECRET_KEY=change_me_secret_key_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# OCR
PADDLE_OCR_MODEL_DIR=/app/models/PaddlePaddle/PaddleOCR-VL

# File Upload
MAX_FILE_SIZE=524288000
ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.tiff,.bmp

# arq (async task queue based on Redis, uses database=1)
# arq 复用 REDIS_URL 中的主机与端口，使用 database=1 作为任务队列
