# Application
APP_NAME=Hansight
APP_ENV=development
DEBUG=true

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=docparser
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://postgres:change_me@localhost:5432/docparser

# Redis
REDIS_URL=redis://localhost:6379/0

# S3兼容存储 (SeaweedFS，字段名保留兼容)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio
MINIO_BUCKET=documents
MINIO_SECURE=false

# S3 Compatible Storage (SeaweedFS)
S3_ENDPOINT_URL=http://localhost:9000

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_neo4j

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=doc_chunks

# Embedding (bge-m3 Dense+Sparse)
EMBEDDING_MODEL_PATH=/home/hanson/doc_parse_project/models/bge-m3
EMBEDDING_BATCH_SIZE=16

# vLLM 大语言模型权重目录路径
LLM_MODEL_PATH=/home/hanson/doc_parse_project/models/Qwen/Qwen3___5-9B

# JWT
SECRET_KEY=change_me_secret_key_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# OCR
PADDLE_OCR_MODEL_DIR=/app/models/PaddlePaddle/PaddleOCR-VL
# OCR 文本清洗等级：light / medium / deep
OCR_CLEAN_LEVEL=medium

# OCR 引擎切换（MinerU 主 / PaddleOCR 备）
# 全局默认引擎：paddleocr / mineru / glmocr / auto
OCR_ENGINE=mineru
# MinerU 推理后端：pipeline / vlm-engine / vlm-http-client / hybrid-engine / hybrid-http-client
MINERU_BACKEND=pipeline
# MinerU VLM 后端 vLLM 服务端点（仅 vlm-* / hybrid-* 后端使用）
MINERU_VLLM_SERVER_URL=http://localhost:9988/v1
# MinerU OCR 语言
MINERU_LANG=ch
# MinerU 公式/表格识别开关
MINERU_FORMULA_ENABLE=true
MINERU_TABLE_ENABLE=true
# MinerU 输出临时目录（每次任务子目录隔离，用后清理）
MINERU_OUTPUT_DIR=/tmp/mineru_output
# MinerU hybrid 后端 effort（medium/high），仅 hybrid-* 后端生效
MINERU_HYBRID_EFFORT=medium
# MinerU 图像分析（图表/插图理解）
MINERU_IMAGE_ANALYSIS=true

# GLM-OCR 引擎（vLLM 服务，默认 9977 端口）
# 混合预处理：方向校正 + 倾斜校正 + 条件增强 + PP-DocLayoutV3 + 区域级 GLM-OCR 识别
GLMOCR_SERVER_URL=http://localhost:9977/v1
GLMOCR_MODEL=glm-ocr
GLMOCR_API_KEY=
GLMOCR_PDF_DPI=200
GLMOCR_MAX_CONCURRENCY=20
GLMOCR_MODE=fullpage

# File Upload
MAX_FILE_SIZE=524288000
ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.tiff,.bmp

# arq (async task queue based on Redis, uses database=1)
# arq 复用 REDIS_URL 中的主机与端口，使用 database=1 作为任务队列

# ---------------------------------------------------------------
# 检测项目字典（三元基础表）配置
# ---------------------------------------------------------------
# （基础三表已移除，由术语集替代，以下 PROJECT_DICT_* 配置不再需要）
# 原检测项目字典同步 URL / 白名单 / 向量集合 / 匹配阈值配置已移除
# ---------------------------------------------------------------
