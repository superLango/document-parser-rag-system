# ============================================================
# HansonDOC RAG（重构版）后端环境变量模板
# 数据库名固定为 hanson_doc_rag
# ============================================================

# ---------- 应用 ----------
APP_NAME=HansonDOC RAG
APP_ENV=development
DEBUG=true
VERSION=3.0.0
# CORS 来源（逗号分隔；"*" 时强制关闭 credentials）
CORS_ORIGINS=*
# 管理端 IP 白名单（逗号分隔，空=不限制，作用于 /api/v1/admin/*）
ADMIN_IP_WHITELIST=

# ---------- PostgreSQL（主数据库）----------
# 库名固定：hanson_doc_rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hanson_doc_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://postgres:change_me@localhost:5432/hanson_doc_rag

# ---------- Redis（缓存；任务队列后续阶段使用 db1）----------
REDIS_URL=redis://localhost:6379/0

# ---------- JWT ----------
SECRET_KEY=change_me_secret_key_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- 密码与登录安全策略 ----------
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPER=true
PASSWORD_REQUIRE_LOWER=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=false
PASSWORD_HISTORY_SIZE=5
PASSWORD_EXPIRE_DAYS=90
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=30
AUTH_LIMIT=5/minute
RESET_TOKEN_EXPIRE_MINUTES=30

# ---------- 注册与初始管理员 ----------
# 是否开放自助注册（生产环境建议 false）
ALLOW_REGISTRATION=true
# 首次启动时若不存在任何用户，自动创建初始超级管理员
AUTO_CREATE_ADMIN=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---------- 一站式任务状态回调 ----------
# 全流程失败或完成后，将 task_id、status、reason POST 到该地址
INTEGRATION_STATUS_CALLBACK_URL=http://192.168.0.141:4001/oapi/aiDocParse/receiveParseStatus
INTEGRATION_STATUS_CALLBACK_TIMEOUT_SECONDS=10
INTEGRATION_STATUS_CALLBACK_MAX_ATTEMPTS=3

# ---------- 审计 ----------
AUDIT_LOG_RETENTION_DAYS=90

# ---------- 可观测性 ----------
ENABLE_METRICS=false
