# ============================================================================
# HansonDOC RAG 后端环境变量模板
# ============================================================================
# 部署步骤：
#   1. cp backend/.env.example backend/.env
#   2. 按本文件注释填入真实值（标有 change_me 的必须替换）
#   3. 所有 *_MODEL/*_MODEL_ID 必须与对应 vLLM 服务的 --served-model-name 完全一致（大小写敏感）
#   4. 路径类变量请按实际部署目录调整（本文件以 /home/hanson/doc_parse_project 为示例根目录）
# ============================================================================

# ---------- Application ----------
APP_NAME=HansonDOC RAG
APP_ENV=development
DEBUG=true
# CORS 来源（逗号分隔，生产环境应严格限定为前端域名；"*" 时强制关闭 credentials）
CORS_ORIGINS=*
# 管理端 IP 白名单（逗号分隔，空=不限制，作用于 /api/v1/admin/*）
ADMIN_IP_WHITELIST=

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=docparser
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://postgres:change_me@localhost:5432/docparser

# ---------- Redis（db0 缓存，db1 为 arq 任务队列）----------
REDIS_URL=redis://localhost:6379/0

# ---------- MinIO（S3 兼容对象存储，按 KB 分 bucket）----------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio
MINIO_BUCKET=documents
MINIO_SECURE=false
S3_ENDPOINT_URL=http://localhost:9000

# ---------- NebulaGraph（知识图谱，按 KB 分 graph space，替代 Neo4j）----------
NEBULA_GRAPHD_HOST=localhost
NEBULA_GRAPHD_PORT=9669
NEBULA_USER=root
NEBULA_PASSWORD=change_me_nebula
NEBULA_SPACE_PREFIX=kb_
NEBULA_GLOBAL_SPACE=global

# ---------- Milvus（向量数据库，按 KB 分 Collection）----------
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=doc_chunks

# ---------- 知识库隔离命名 ----------
KB_DEFAULT_DOMAIN=material_testing
KB_MINIO_BUCKET_PREFIX=kb-
KB_MILVUS_COLLECTION_SEPARATOR=_
KB_REDIS_KEY_PREFIX=kb:
KB_OCR_DATA_DIR=data/ocr_data

# ---------- 嵌入模型（bge-m3，五维向量）----------
EMBEDDING_MODEL_PATH=/home/hanson/doc_parse_project/models/bge-m3
EMBEDDING_BATCH_SIZE=16

# ---------- vLLM 主 LLM 服务（端口 9988，Qwen3.6-35B-A3B-FP8）----------
# 远程 vLLM OpenAI 兼容 API 模式（设置后优先使用，无需本地安装 vllm）
LLM_API_BASE=http://localhost:9988/v1
LLM_API_MODEL=Qwem3.6-35B-A3B-FP8
LLM_LIGHT_MODEL=Qwem3.6-35B-A3B-FP8
# 本地权重目录（仅非 API 模式使用，一般无需改动）
LLM_MODEL_PATH=/home/hanson/doc_parse_project/models/Qwen/Qwen3.6-35B-A3B-FP8

# ---------- GLM-OCR 引擎（vLLM 服务，端口 9977，主 OCR）----------
# 注意：GLMOCR_MODEL 必须与 vLLM --served-model-name 完全一致（大小写敏感）
GLMOCR_SERVER_URL=http://localhost:9977/v1
GLMOCR_MODEL=GLM-OCR
GLMOCR_API_KEY=
GLMOCR_PDF_DPI=200
GLMOCR_MAX_CONCURRENCY=12
GLMOCR_MAX_TOKENS=4096
GLMOCR_MODE=fullpage

# ---------- 重排模型（bge-reranker-v2-m3 CrossEncoder）----------
RERANKER_MODEL_DIR=models/bge-reranker-v2-m3

# ---------- gliclass 零样本类别分类 ----------
GLICLASS_MODEL_PATH=models/gliclass-multilang-mini
GLICLASS_BATCH_SIZE=16
GLICLASS_MAX_LENGTH=512

# ---------- 五维向量索引 ----------
FIVE_DIM_VECTOR_COLLECTION=doc_five_dim
VECTOR_CHILD_MAX_CHARS=2000

# ---------- 结构化抽取 LLM（OpenAI/vLLM 兼容）----------
EXTRACTION_PROVIDER=openai
EXTRACTION_API_BASE=http://localhost:9988/v1
EXTRACTION_API_KEY=EMPTY
EXTRACTION_MODEL_ID=Qwem3.6-35B-A3B-FP8
EXTRACTION_MAX_CONCURRENCY=12
EXTRACTION_MAX_OUTPUT_TOKENS=32768
EXTRACTION_TEMPERATURE=0.1
EXTRACTION_OUTPUT_SCHEMA_MODE=auto
EXTRACTION_PASSES=1
EXTRACTION_CONTEXT_WINDOW_CHARS=1000
EXTRACTION_MAX_CHAR_BUFFER=20000
EXTRACTION_LANGEXTRACT_MAX_WORKERS=1
EXTRACTION_PROMPT_VALIDATION_LEVEL=warning
EXTRACTION_PROMPT_STATIC_PREFIX_ENABLED=true
EXTRACTION_PROMPT_CACHE_WARMUP_ENABLED=true
EXTRACTION_PROMPT_CACHE_WARMUP_CRON_HOUR=1
EXTRACTION_RECALL_CLASSIFY_FILTER_ENABLED=true
EXTRACTION_RECALL_CLASSIFY_THRESHOLD=0.5
EXTRACTION_RECALL_MIN_CHUNKS=1
EXTRACTION_SEMANTIC_CHUNKING_ENABLED=false
EXTRACTION_SEMANTIC_CHUNK_SIZE=8000
EXTRACTION_SEMANTIC_CHUNK_MIN_SIZE=1000
EXTRACTION_CHUNK_SUMMARY_ENABLED=false

# ---------- v3 结构化抽取（五维向量底座，双线路 LLM 抽取）----------
EXTRACTION_V3_LLM_API_BASE=http://localhost:9988/v1
EXTRACTION_V3_LLM_MODEL=Qwem3.6-35B-A3B-FP8
EXTRACTION_V3_LLM_API_KEY=EMPTY
EXTRACTION_V3_LLM_MAX_CONCURRENCY=24
EXTRACTION_V3_LLM_MAX_OUTPUT_TOKENS=32768
EXTRACTION_V3_LLM_TEMPERATURE=0.0
EXTRACTION_V3_LLM_TOP_P=0.1
EXTRACTION_V3_LLM_TOP_K=20
EXTRACTION_V3_EXTRACTION_ENGINE=BaseExtract
EXTRACTION_V3_EXTRACTION_FALLBACK_TO_GLMOCR=true
EXTRACTION_V3_CATEGORY_CONFIDENCE_THRESHOLD=0.35
EXTRACTION_V3_CATEGORY_CONCURRENCY=8
EXTRACTION_V3_RETRIEVAL_TOP_K=20
EXTRACTION_V3_RETRIEVAL_PER_DIM_TOP_K=30
EXTRACTION_V3_RETRIEVAL_RERANK_ENABLED=true
EXTRACTION_V3_RETRIEVAL_RERANK_TOP_K=15
EXTRACTION_V3_CONTEXT_MAX_TOKENS=28000
EXTRACTION_V3_HYBRID_SEARCH_WEIGHTS=path:0.15,title:0.20,content:0.45,type:0.05,structural:0.15
EXTRACTION_V3_LANGEXTRACT_PASSES=2
EXTRACTION_V3_LANGEXTRACT_MAX_WORKERS=3
EXTRACTION_V3_LANGEXTRACT_CONTEXT_WINDOW_CHARS=28000
EXTRACTION_V3_LANGEXTRACT_MAX_CHAR_BUFFER=40000
EXTRACTION_V3_LARGE_TABLE_THRESHOLD=8000
EXTRACTION_V3_LARGE_TABLE_BATCH_CHARS=6000
EXTRACTION_V3_GLMOCR_CONTEXT_TRUNCATE=32000
EXTRACTION_V3_BATCH_OVERLAP_CHARS=500
EXTRACTION_V3_ITEM_NORMALIZE_SIM_THRESHOLD=0.90
EXTRACTION_V3_CROSS_VALIDATE_THRESHOLD=0.35
EXTRACTION_V3_DEDUP_SIM_THRESHOLD=0.95
EXTRACTION_V3_EDIT_DISTANCE_THRESHOLD=0.85

# ---------- OCR 通用配置 ----------
OCR_OUTPUT_DIR=./data/ocr_data
OCR_CLEAN_LEVEL=medium
# 全局默认 OCR 引擎：glmocr / mineru / paddleocr / auto
OCR_ENGINE=glmocr
# MinerU 推理后端：pipeline / vlm-engine / vlm-http-client / hybrid-engine / hybrid-http-client
MINERU_BACKEND=pipeline
MINERU_VLLM_SERVER_URL=http://localhost:9988/v1
MINERU_LANG=ch
MINERU_FORMULA_ENABLE=true
MINERU_TABLE_ENABLE=true
MINERU_OUTPUT_DIR=/tmp/mineru_output
MINERU_HYBRID_EFFORT=medium
MINERU_IMAGE_ANALYSIS=true
# PaddleOCR 模型目录（备选引擎）
PADDLE_OCR_MODEL_DIR=/home/hanson/doc_parse_project/models/PaddlePaddle/PaddleOCR-VL

# ---------- arq 异步任务队列 ----------
# arq 复用 REDIS_URL 中的主机与端口，使用 database=1 作为任务队列（与 db0 缓存隔离）

# ---------- RAG 编排 ----------
RAG_TOP_K=5
RAG_RERANK_POOL=15
RAG_MAX_CONTEXT_LENGTH=8192

# ---------- JWT 鉴权 ----------
SECRET_KEY=change_me_secret_key_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- Ollama（兼容保留，一般不使用）----------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# ---------- 生产级安全策略 ----------
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPER=true
PASSWORD_REQUIRE_LOWER=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=false
PASSWORD_HISTORY_SIZE=5
PASSWORD_EXPIRE_DAYS=90
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=30
RESET_TOKEN_EXPIRE_MINUTES=30
AUDIT_LOG_RETENTION_DAYS=90

# ---------- 文件上传 ----------
MAX_FILE_SIZE=524288000
ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.tiff,.bmp

# ---------- 一体化公开接口 ----------
# 公开一体化接口默认知识库 ID（需预先在该 KB 配置好抽取配置：Schema/Prompt/术语集/LLM 端点）
# 未配置时 POST /public/extraction/upload 必须显式传 kb_id 参数
PUBLIC_KB_ID=
