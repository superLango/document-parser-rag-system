# Runtime
APP_ENV=dev
LOG_LEVEL=INFO

# PostgreSQL (host port mapped to 15432)
DATABASE_URL=postgresql://hanson:hanson@localhost:15432/hanson

# Redis (host port mapped to 16379)
REDIS_URL=redis://localhost:16379/0

# Object storage (local dev/test: MinIO, host ports 19000/19001)
OBJECT_STORAGE_ENDPOINT=http://localhost:19000
OBJECT_STORAGE_BUCKET=hanson-docs
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# Model servers (Q1: three addresses)
AGENT_BASE_URL_PRIMARY=
AGENT_BASE_URL_SECONDARY=
AGENT_BASE_URL_TERTIARY=http://192.168.1.35
AGENT_FAILOVER_SECONDS=10
AGENT_FAILOVER_COOLDOWN=30
AGENT_MODEL=Qwen-35B
AGENT_CONTEXT_WINDOW=65536
AGENT_MAX_OUTPUT_TOKENS=4096
MODEL_TEST_MEMORY_FLOOR_MB=2048

# OCR
OCR_BACKEND=auto
OCR_DPI=150
OCR_URL=http://localhost:18002
OCR_USE_FAKE=false
GLM_OCR_BASE_URL=
GLM_OCR_MODEL=
GLM_OCR_TIMEOUT_SECONDS=180
LAYOUT_BASE_URL=

# Orchestration
MOCK_STAGE_DELAY_SECONDS=0.2
STAGE_MAX_ATTEMPTS=2
STAGE_RETRY_BACKOFF_SECONDS=0.5
# 开发期故障注入（仅用于验证阶段重试）
MOCK_FAIL_STAGE=
MOCK_FAIL_TIMES=0

# Sandbox
SANDBOX_IMAGE=
SANDBOX_CPU=2
SANDBOX_MEMORY_MB=4096
SANDBOX_TIMEOUT=600

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
