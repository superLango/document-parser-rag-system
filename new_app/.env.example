# Runtime
APP_ENV=dev
LOG_LEVEL=INFO

# PostgreSQL (host port mapped to 15432)
DATABASE_URL=postgresql://hanson:hanson@localhost:15432/hanson

# Redis (host port mapped to 16379)
REDIS_URL=redis://localhost:16379/0

# Object storage (local dev/test: MinIO, host ports 19000/19001)
OBJECT_STORAGE_ENDPOINT=http://localhost:19000
OBJECT_STORAGE_BUCKET=hanson-docs
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# Model servers (Q1: three addresses)
# primary/secondary 是旧代码记录地址；当前可能离线或模型不匹配，
# agent-service 启动/周期探测会把它们标记为不可用并自动使用 tertiary。
AGENT_BASE_URL_PRIMARY=http://39.107.239.208:35035
AGENT_BASE_URL_SECONDARY=http://192.168.188.75:9991
AGENT_BASE_URL_TERTIARY=http://192.168.1.35:9988
AGENT_FAILOVER_SECONDS=10
AGENT_FAILOVER_COOLDOWN=30
AGENT_MODEL=Qwen3.6-35B-A3B-NVFP4
AGENT_CONTEXT_WINDOW=65536
AGENT_MAX_OUTPUT_TOKENS=4096
AGENT_TOKENIZER_MODE=remote
AGENT_SESSION_DB=/tmp/hanson-agent/sessions.db
MODEL_TEST_MEMORY_FLOOR_MB=2048
AGENT_WATCHDOG_FLOOR_MB=4096

# Review service
REVIEW_URL=http://localhost:18006
REVIEW_AGENT_URL=http://localhost:18003
REVIEW_USE_AGENT=true
# Orchestration calls the agent service for feedback triage/repair
AGENT_URL=http://localhost:18003
FEEDBACK_TIMEOUT_SECONDS=300

# OCR
OCR_BACKEND=auto
OCR_DPI=150
OCR_URL=http://localhost:18002
OCR_USE_FAKE=false
GLM_OCR_BASE_URL=
GLM_OCR_MODEL=
GLM_OCR_TIMEOUT_SECONDS=180
LAYOUT_BASE_URL=http://192.168.1.35:9978
LAYOUT_TIMEOUT_SECONDS=60

# Orchestration
MOCK_STAGE_DELAY_SECONDS=0.2
STAGE_MAX_ATTEMPTS=2
STAGE_RETRY_BACKOFF_SECONDS=0.5
RECIPE_REGISTRY_URL=http://localhost:18005
ROUTE_USE_FAKE=false
# 开发期故障注入（仅用于验证阶段重试）
MOCK_FAIL_STAGE=
MOCK_FAIL_TIMES=0

# Sandbox
SANDBOX_IMAGE=
SANDBOX_CPU=2
SANDBOX_MEMORY_MB=4096
SANDBOX_TIMEOUT=600

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
