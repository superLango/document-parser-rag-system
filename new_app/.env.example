# Runtime
APP_ENV=dev
LOG_LEVEL=INFO

# PostgreSQL (host port mapped to 15432)
DATABASE_URL=postgresql://hanson:hanson@localhost:15432/hanson

# Redis (host port mapped to 16379)
REDIS_URL=redis://localhost:16379/0

# Object storage (local dev/test: MinIO, host ports 19000/19001)
OBJECT_STORAGE_ENDPOINT=http://localhost:19000
OBJECT_STORAGE_BUCKET=hanson-docs
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# Model servers (Q1: three addresses)
# primary/secondary 是旧代码记录地址；当前可能离线或模型不匹配，
# agent-service 启动/周期探测会把它们标记为不可用并自动使用 tertiary。
AGENT_BASE_URL_PRIMARY=http://39.107.239.208:35035
AGENT_BASE_URL_SECONDARY=http://192.168.1.35:9991
AGENT_BASE_URL_TERTIARY=http://192.168.1.35:9988
AGENT_FAILOVER_SECONDS=10
AGENT_FAILOVER_COOLDOWN=30
AGENT_MODEL=Qwen3.6-35B-A3B-NVFP4
AGENT_CONTEXT_WINDOW=65536
AGENT_MAX_OUTPUT_TOKENS=4096
AGENT_TOKENIZER_MODE=remote
AGENT_SESSION_DB=/tmp/hanson-agent/sessions.db
# dev 才启用开发期延迟与故障注入；生产必须设置为 production
ENVIRONMENT=dev
# Agent 工具的沙箱/审核服务地址（留空则工具返回 not_configured）
AGENT_SANDBOX_URL=http://sandbox:8004
AGENT_REVIEW_URL=http://review:8006
MODEL_TEST_MEMORY_FLOOR_MB=2048
AGENT_WATCHDOG_FLOOR_MB=4096

# Review service
REVIEW_URL=http://localhost:18006
REVIEW_AGENT_URL=http://localhost:18003
REVIEW_USE_AGENT=true
# 人工审核门：REVIEW_PASSED 后必须经人工 approve 才能进入 STRUCTURED_READY
HUMAN_REVIEW_REQUIRED=true
# review 失败后自动修复并重跑沙箱（最多 N 次）
AUTO_REPAIR_ENABLED=false
AUTO_REPAIR_MAX_ATTEMPTS=2
# L3 代码补丁审批令牌；为空时审批端点拒绝（fail closed）
INTERNAL_API_TOKEN=change-me-approval-token
# 可选：设置后所有服务要求 Authorization: Bearer <token>；为空保持内网免鉴权
API_AUTH_TOKEN=
# Orchestration calls the agent service for feedback triage/repair
AGENT_URL=http://localhost:18003
FEEDBACK_TIMEOUT_SECONDS=300
# Shadow 灰度（方案 B）：满额后默认等人工确认；显式开启才自动晋升
SHADOW_REQUIRED_DOCUMENTS=10
SHADOW_AUTO_PROMOTE=false
SHADOW_TIMEOUT_SECONDS=604800
# 版本画像/漂移自适应（P1-12/Phase 2）；默认启用，仅做建议不阻断解析
EDITION_PROFILE_ENABLED=true
EDITION_PROFILE_DIR=

# OCR
OCR_BACKEND=auto
OCR_DPI=150
OCR_URL=http://localhost:18002
OCR_TIMEOUT_SECONDS=2400
OCR_USE_FAKE=false
GLM_OCR_BASE_URL=http://192.168.1.35:9977/v1
GLM_OCR_MODEL=GLM-OCR
GLM_OCR_TIMEOUT_SECONDS=180
GLM_OCR_READ_TIMEOUT_SECONDS=300
GLM_OCR_MAX_TOKENS=8192
LAYOUT_BASE_URL=http://192.168.1.35:9978
LAYOUT_TIMEOUT_SECONDS=15
OCR_LAYOUT_FIRST=true

# Orchestration
MOCK_STAGE_DELAY_SECONDS=0.2
STAGE_MAX_ATTEMPTS=2
STAGE_RETRY_BACKOFF_SECONDS=0.5
RECIPE_REGISTRY_URL=http://localhost:18005
ROUTE_USE_FAKE=false
# 低置信表调用 RouterAgent；只处理高质量性能/成分表，其余转人工
ROUTE_AGENT_ENABLED=true
# 开发期故障注入（仅用于验证阶段重试）
MOCK_FAIL_STAGE=
MOCK_FAIL_TIMES=0

# Sandbox
SANDBOX_IMAGE=
SANDBOX_CPU=2
SANDBOX_MEMORY_MB=4096
SANDBOX_TIMEOUT=600

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
