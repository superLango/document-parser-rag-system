# Engine plane: metal-doc-agent API and worker share this image.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    METAL_DOC_HOME=/app/metal-doc-agent \
    METAL_DOC_DATA=/data/engine

ARG PIP_INDEX_URL=https://pypi.org/simple

WORKDIR /app
COPY metal-doc-agent /app/metal-doc-agent
RUN pip install --no-cache-dir --index-url "$PIP_INDEX_URL" \
    --timeout 120 --retries 8 \
    -e "/app/metal-doc-agent[api,yaml,models]"
# Keep packaging tooling out of the scanned blast radius (pip/setuptools advisories).
RUN pip install --no-cache-dir --index-url "$PIP_INDEX_URL" \
    --timeout 120 --retries 8 --upgrade pip setuptools

WORKDIR /app/metal-doc-agent
EXPOSE 8010
CMD ["uvicorn", "metal_doc_agent.api:app", "--host", "0.0.0.0", "--port", "8010"]
